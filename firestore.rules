rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /projects/{projectId} {
      // Only the owner can read or write their own project
      allow read, write: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Allow creation — the server (Admin SDK) writes ownerId, but client can also create
      // through the Cloud Function, so direct client writes are blocked for create.
      // Reading newly-created doc: ownerId is already set by the Cloud Function.

      // Editor content subcollection — checked against parent project ownership
      match /data/{docId} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    match /images/{imageId} {
      // Owner can read and delete their own images
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Client can create URL-type images directly (uploaded images are created by the Cloud Function via Admin SDK)
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.type == 'url';
    }
  }
}
